# Always HTTPS, also in Laragon (docs/12 SEC-32).
# app.baseURL = 'https://spensada.test/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Write DBDriver without quotes (docs/07 ARS-45 item 5).
# database.default.hostname = localhost
# database.default.database = spensada
# database.default.username = root
# database.default.password =
# database.default.DBDriver = App\Database\MySQLi
# database.default.port = 3306

# Tests use MySQL database spensada_test, without a table prefix (ARS-45).
# database.tests.hostname = 127.0.0.1
# database.tests.database = spensada_test
# database.tests.username = root
# database.tests.password =
# database.tests.DBDriver = App\Database\MySQLi
