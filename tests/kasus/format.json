{
    "description": "Shared format cases for app/Helpers/format_helper.php (PHPUnit) and public/aset/js/format.js (node --test). fn is the PHP helper name; args are passed as-is; throws means the call must fail.",
    "cases": [
        { "fn": "format_date", "args": ["2026-10-13 07:32:05"], "expected": "13 Oktober 2026" },
        { "fn": "format_date", "args": ["2026-10-13 07:32:05", "long"], "expected": "13 Oktober 2026" },
        { "fn": "format_date", "args": ["2026-10-13 07:32:05", "full"], "expected": "Selasa, 13 Oktober 2026" },
        { "fn": "format_date", "args": ["2026-10-13 07:32:05", "short"], "expected": "13 Okt 2026" },
        { "fn": "format_date", "args": ["2026-10-13 07:32:05", "day"], "expected": "13 Okt" },
        { "fn": "format_date", "args": ["2026-10-13 07:32:05", "numeric"], "expected": "13/10/2026" },
        { "fn": "format_date", "args": ["2026-08-05", "numeric"], "expected": "05/08/2026" },

        { "fn": "format_date", "args": ["2026-01-04", "full"], "expected": "Minggu, 4 Januari 2026" },
        { "fn": "format_date", "args": ["2026-02-02", "full"], "expected": "Senin, 2 Februari 2026" },
        { "fn": "format_date", "args": ["2026-03-03", "full"], "expected": "Selasa, 3 Maret 2026" },
        { "fn": "format_date", "args": ["2026-04-01", "full"], "expected": "Rabu, 1 April 2026" },
        { "fn": "format_date", "args": ["2026-05-07", "full"], "expected": "Kamis, 7 Mei 2026" },
        { "fn": "format_date", "args": ["2026-06-05", "full"], "expected": "Jumat, 5 Juni 2026" },
        { "fn": "format_date", "args": ["2026-07-04", "full"], "expected": "Sabtu, 4 Juli 2026" },
        { "fn": "format_date", "args": ["2026-08-17", "full"], "expected": "Senin, 17 Agustus 2026" },
        { "fn": "format_date", "args": ["2026-09-01", "full"], "expected": "Selasa, 1 September 2026" },
        { "fn": "format_date", "args": ["2026-11-06", "full"], "expected": "Jumat, 6 November 2026" },
        { "fn": "format_date", "args": ["2026-12-25", "full"], "expected": "Jumat, 25 Desember 2026" },

        { "fn": "format_date", "args": ["2026-01-04", "short"], "expected": "4 Jan 2026" },
        { "fn": "format_date", "args": ["2026-02-02", "short"], "expected": "2 Feb 2026" },
        { "fn": "format_date", "args": ["2026-03-03", "short"], "expected": "3 Mar 2026" },
        { "fn": "format_date", "args": ["2026-04-01", "short"], "expected": "1 Apr 2026" },
        { "fn": "format_date", "args": ["2026-05-07", "short"], "expected": "7 Mei 2026" },
        { "fn": "format_date", "args": ["2026-06-05", "short"], "expected": "5 Jun 2026" },
        { "fn": "format_date", "args": ["2026-07-04", "short"], "expected": "4 Jul 2026" },
        { "fn": "format_date", "args": ["2026-08-17", "short"], "expected": "17 Agu 2026" },
        { "fn": "format_date", "args": ["2026-09-01", "short"], "expected": "1 Sep 2026" },
        { "fn": "format_date", "args": ["2026-11-06", "short"], "expected": "6 Nov 2026" },
        { "fn": "format_date", "args": ["2026-12-25", "day"], "expected": "25 Des" },

        { "fn": "format_date", "args": ["2026-10-12T17:00:00Z", "full"], "expected": "Selasa, 13 Oktober 2026" },
        { "fn": "format_date", "args": ["2026-10-12T16:59:59Z", "full"], "expected": "Senin, 12 Oktober 2026" },
        { "fn": "format_date", "args": ["2026-12-31T17:00:00+00:00"], "expected": "1 Januari 2027" },
        { "fn": "format_date", "args": ["2026-10-13 00:00:00", "short"], "expected": "13 Okt 2026" },
        { "fn": "format_date", "args": ["2026-10-13 23:59:59", "short"], "expected": "13 Okt 2026" },
        { "fn": "format_date", "args": [1791851525, "short"], "expected": "13 Okt 2026" },

        { "fn": "format_time", "args": ["2026-10-13 07:32:05"], "expected": "07.32" },
        { "fn": "format_time", "args": ["2026-10-13 07:32:05", true], "expected": "07.32.05" },
        { "fn": "format_time", "args": ["2026-10-13"], "expected": "00.00" },
        { "fn": "format_time", "args": ["2026-10-13T23:59:59+07:00", true], "expected": "23.59.59" },
        { "fn": "format_time", "args": ["2026-10-13T00:32:05Z", true], "expected": "07.32.05" },
        { "fn": "format_time", "args": ["2026-10-13T13:05:00+00:00"], "expected": "20.05" },
        { "fn": "format_time", "args": [1791851525, true], "expected": "07.32.05" },

        { "fn": "format_datetime", "args": ["2026-10-13 07:32:05"], "expected": "13 Okt 2026, 07.32" },
        { "fn": "format_datetime", "args": ["2026-10-13 07:32:05", true], "expected": "13 Okt 2026, 07.32.05" },
        { "fn": "format_datetime", "args": ["2026-10-12T17:00:00Z"], "expected": "13 Okt 2026, 00.00" },
        { "fn": "format_datetime", "args": ["2026-10-12T16:59:59Z", true], "expected": "12 Okt 2026, 23.59.59" },
        { "fn": "format_datetime", "args": [1791851525], "expected": "13 Okt 2026, 07.32" },

        { "fn": "format_number", "args": [1024], "expected": "1.024" },
        { "fn": "format_number", "args": [0], "expected": "0" },
        { "fn": "format_number", "args": [999], "expected": "999" },
        { "fn": "format_number", "args": [1234567], "expected": "1.234.567" },
        { "fn": "format_number", "args": [-1234567], "expected": "-1.234.567" },
        { "fn": "format_number", "args": [12.5, 1], "expected": "12,5" },
        { "fn": "format_number", "args": [12, 1], "expected": "12,0" },
        { "fn": "format_number", "args": [1234.5], "expected": "1.235" },
        { "fn": "format_number", "args": [2.5], "expected": "3" },
        { "fn": "format_number", "args": [-2.5], "expected": "-3" },
        { "fn": "format_number", "args": [1.005, 2], "expected": "1,01" },
        { "fn": "format_number", "args": [0.285, 2], "expected": "0,29" },
        { "fn": "format_number", "args": [-0.4], "expected": "0" },
        { "fn": "format_number", "args": ["1250000.5", 2], "expected": "1.250.000,50" },

        { "fn": "format_rupiah", "args": [1250000], "expected": "Rp 1.250.000" },
        { "fn": "format_rupiah", "args": [-1250000], "expected": "-Rp 1.250.000" },
        { "fn": "format_rupiah", "args": [0], "expected": "Rp 0" },
        { "fn": "format_rupiah", "args": [-0.4], "expected": "Rp 0" },
        { "fn": "format_rupiah", "args": ["1250000"], "expected": "Rp 1.250.000" },
        { "fn": "format_rupiah", "args": [999.5], "expected": "Rp 1.000" },
        { "fn": "format_rupiah", "args": [-999.5], "expected": "-Rp 1.000" },
        { "fn": "format_rupiah", "args": [1500.75, 2], "expected": "Rp 1.500,75" },

        { "fn": "format_percent", "args": [87.5], "expected": "88%" },
        { "fn": "format_percent", "args": [87.4], "expected": "87%" },
        { "fn": "format_percent", "args": [57.49999999999999], "expected": "58%" },
        { "fn": "format_percent", "args": [27.500000000000004], "expected": "28%" },
        { "fn": "format_percent", "args": [66.66666666666667], "expected": "67%" },
        { "fn": "format_percent", "args": [0], "expected": "0%" },
        { "fn": "format_percent", "args": [100], "expected": "100%" },
        { "fn": "format_percent", "args": [-87.5], "expected": "-88%" },
        { "fn": "format_percent", "args": [-0.4], "expected": "0%" },
        { "fn": "format_percent", "args": [1234.5], "expected": "1.235%" },
        { "fn": "format_percent", "args": ["12.5"], "expected": "13%" },

        { "fn": "format_date", "args": [null], "expected": "" },
        { "fn": "format_date", "args": ["", "full"], "expected": "" },
        { "fn": "format_time", "args": [""], "expected": "" },
        { "fn": "format_datetime", "args": [null, true], "expected": "" },
        { "fn": "format_number", "args": [null], "expected": "" },
        { "fn": "format_rupiah", "args": [""], "expected": "" },
        { "fn": "format_percent", "args": [null], "expected": "" },

        { "fn": "format_date", "args": ["2026-10-13", "iso"], "throws": true },
        { "fn": "format_date", "args": ["bukan tanggal"], "throws": true }
    ]
}
